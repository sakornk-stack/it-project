{
  "name": "eduanalyze-ai",
  "version": "0.1.0",
  "private": true,
  "description": "EduAnalyzeAI - Academic progress tracking and learning outcome analytics system",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "prisma:generate": "npm run prisma:generate --workspace=apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/backend",
    "lint": "npm run lint --workspace=apps/backend && npm run lint --workspace=apps/frontend",
    "test:backend": "npm run test --workspace=apps/backend",
    "test:e2e": "npm test --prefix e2e",
    "docker:rebuild": "docker compose up -d --build",
    "docker:rebuild:frontend": "docker compose up -d --build frontend",
    "docker:rebuild:backend": "docker compose up -d --build backend",
    "docker:check-fresh": "bash scripts/check-docker-freshness.sh",
    "docker:stop": "docker compose stop",
    "db:backup": "bash scripts/db-backup.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.4.0",
      "body-parser": "1.20.8"
    },
    "express": {
      "qs": "6.16.1"
    },
    "body-parser": {
      "qs": "6.16.1"
    },
    "@nestjs/config": {
      "lodash": "4.18.1"
    },
    "@nestjs/swagger": {
      "lodash": "4.18.1",
      "js-yaml": "4.3.2"
    }
  }
}
