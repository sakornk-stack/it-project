# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Idle session timeout (all roles). A warning dialog appears WARNING_SECONDS before
# the user is signed out after IDLE_TIMEOUT_MINUTES without activity. SESSION_MAX_HOURS
# is the absolute cap from login (cannot be extended) and must match the backend's
# SESSION_ABSOLUTE_MAX_HOURS — the backend is what actually enforces it.
# Defaults (used when unset or invalid): 30 / 60 / 8
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_IDLE_WARNING_SECONDS=60
NEXT_PUBLIC_SESSION_MAX_HOURS=8

# Set to true to show the "Sign in with Google" buttons (login + register). Hidden by default.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
