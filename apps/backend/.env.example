# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Reverse-proxy hops in front of the API (nginx = 1, CDN + nginx = 2). Lets the
# per-IP rate limit see the real client IP. Leave 0 when the API is exposed
# directly — trusting a proxy that is not there lets clients spoof their IP.
TRUST_PROXY_HOPS=0
# Seed/import scripts (prisma/seed.ts, prisma/import-*.ts, ...) refuse to run
# when NODE_ENV=production. To run one on purpose, set ALLOW_PROD_SEED=yes for
# that single command only — do not put it in this file.
# ALLOW_PROD_SEED=

# Database — Docker Postgres (docker-compose.yml), published on host port
# 5433 (not 5432) so it never collides with a pre-existing Homebrew
# Postgres install. POSTGRES_USER/POSTGRES_PASSWORD are also read directly
# by docker-compose.yml's postgres service (POSTGRES_DB is hardcoded to
# eduanalyze_ai there to match this).
DATABASE_URL="postgresql://eduanalyze:change_me_postgres_password@localhost:5433/eduanalyze_ai?schema=public"
POSTGRES_USER=eduanalyze
POSTGRES_PASSWORD=change_me_postgres_password

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Hard cap on a session measured from login (hours); /auth/refresh refuses past it.
# Keep in sync with the frontend's NEXT_PUBLIC_SESSION_MAX_HOURS.
SESSION_ABSOLUTE_MAX_HOURS=8
# Signs the short-lived "pending 2FA" token issued between password-verify
# and TOTP-code-verify (POST /auth/2fa/verify) — a separate secret from
# access/refresh so a leaked pending token can never be replayed as either.
JWT_2FA_PENDING_SECRET=change_me_2fa_pending_secret
JWT_2FA_PENDING_EXPIRES_IN=5m

# Google OAuth — register a real project in Google Cloud Console and
# replace these before using; non-empty placeholders only (passport's
# OAuth2Strategy throws at boot on an empty clientID).
GOOGLE_CLIENT_ID=change_me_google_client_id
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# true = new Google sign-ups must be Workspace accounts of an allowed domain (hd claim)
GOOGLE_REQUIRE_HOSTED_DOMAIN=false

# Self-service sign-up (email+password and Google) is limited to these domains,
# exact match. Default ku.th. Local testing may use: ku.th,test.local
SELF_SIGNUP_ALLOWED_DOMAINS=ku.th

# Email (SMTP) — used for forgot-password reset links and the
# "set your password" email sent when an ADMIN/SUPER_ADMIN creates a
# STAFF/INSTRUCTOR/ADMIN account (see EmailService). Gmail SMTP (free):
# host smtp.gmail.com, port 587. SMTP_PASS must be a Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords) —
# your normal Gmail password will be rejected, Google blocks plain SMTP
# auth on it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@gmail.com
SMTP_PASS=change_me_gmail_app_password
SMTP_FROM=change_me@gmail.com
# Optional: send through Brevo's HTTPS API instead of SMTP (needed on Render's
# free plan, which blocks SMTP ports). SMTP_FROM must be a Brevo-verified sender.
BREVO_API_KEY=

# TOTP 2FA — encrypts TwoFactorCredential.secretCiphertext (AES-256-GCM,
# see common/util/crypto.util.ts). Generate with `openssl rand -hex 32`
# (must be exactly 64 hex characters). If this key is ever lost or
# rotated, every user's TOTP secret becomes permanently undecryptable —
# see schema.prisma's comment on TwoFactorCredential for the recovery
# runbook (SUPER_ADMIN deletes the row directly via the database).
TOTP_ENCRYPTION_KEY=change_me_64_hex_chars_from_openssl_rand_hex_32

# AI Skill Analysis (§25-26) — Anthropic API, called live per request (no
# caching/persistence yet, see TODO.md). Replace with a real key before use.
# Empty or `disabled` turns AI analysis off (503 before any data is read or
# sent). Production keeps `disabled` until the privacy policy names the
# transfer to this outside provider and the university has approved it.
ANTHROPIC_API_KEY=change_me_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Docker image entrypoint (apps/backend/docker-entrypoint.sh) builds
# DATABASE_URL inside the container from POSTGRES_USER/POSTGRES_PASSWORD and
# these two (defaults shown); the DATABASE_URL above is for native dev only.
# POSTGRES_HOST=postgres
# POSTGRES_DB=eduanalyze_ai

# docker-compose.yml settings are compose variables, read from the shell or a
# .env next to docker-compose.yml, not from this file. Local dev needs none of
# them (defaults: this file, ports 127.0.0.1:3000/3001, local image names).
# The VPS sets them in ~/eduanalyze/.env (deploy/make-env.sh); see ENV_VARS.md:
# COMPOSE_PROJECT_NAME, APP_ENV_FILE, DB_ENV_FILE, BACKEND_IMAGE,
# FRONTEND_IMAGE, MIGRATOR_IMAGE, IMAGE_TAG, FRONTEND_PORT, BACKEND_PORT
