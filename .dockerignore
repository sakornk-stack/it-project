# Single root .dockerignore — both apps/backend/Dockerfile and
# apps/frontend/Dockerfile build with context "." (repo root), which is
# the only place Docker actually reads a .dockerignore from by default.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
.next-build
**/.next-build
coverage
**/coverage
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets: no env file of any kind goes into an image (examples are harmless).
.env
.env*
**/.env*
**/db.env
!**/.env.example

# Real data and private material: database dumps, curriculum sources, design
# references, VPS backups.
**/.backups
backups
**/private-data
.design-ref
DEPLOY_GUIDE.md

# Tooling and audit output, not needed to build
.git
.github
.claude
.agents
skills-lock.json
issues.json
sonar-issues.json
sonar-project.properties
*.pdf
**/*.tmp.js
**/*.tmp.js.map
**/*.tmp.d.ts
*.log
.DS_Store
**/.DS_Store
